# ==============================================================================
# NER LogiSense - Unified Master Environment Configuration Template
# Copy this file to .env in your root directory or relevant service folders
# ==============================================================================

# =========================
# APPLICATION
# =========================
APP_ENV=development
APP_BASE_URL=http://localhost:8080
SERVER_PORT=8080

# =========================
# AUTH & SECURITY
# =========================
# SECURITY: Never commit real production secrets to source control.
# In production (APP_ENV=production / NODE_ENV=production), services will fail fast if JWT_SECRET is unset.
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars-long
JWT_ISSUER=ner-logisense-auth
JWT_AUDIENCE=ner-logisense-clients
JWT_EXPIRATION_MS=86400000
# Closed System Enforcement: Public self-registration is strictly disabled.
# Accounts are exclusively provisioned by authenticated System Administrators.
ALLOW_PUBLIC_REGISTRATION=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# =========================
# DATABASE (PostgreSQL / PostGIS)
# =========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ner_logistics
POSTGRES_USER=sih_admin
POSTGRES_PASSWORD=sih_secure_password_2026

# Backwards compatibility aliases
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ner_logistics
DB_USER=sih_admin
DB_PASSWORD=sih_secure_password_2026

# =========================
# REDIS
# =========================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================
# KAFKA
# =========================
KAFKA_BROKERS=localhost:9092
KAFKA_SERVERS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=

# =========================
# MQTT / IoT
# =========================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# =========================
# MAP / GIS
# =========================
MAP_PROVIDER=mapbox
MAP_API_KEY=your_mapbox_api_key_here

# =========================
# WEATHER
# =========================
WEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHERMAP_API_KEY=your_openweather_api_key_here

# =========================
# ROUTING
# =========================
ROUTING_PROVIDER=ors
ROUTING_API_KEY=your_openrouteservice_api_key_here

# =========================
# NOTIFICATIONS (Twilio)
# =========================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12015550123
TWILIO_WHATSAPP_NUMBER=whatsapp:+12015550123

# =========================
# EMAIL
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@nerlogisense.gov.in
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=NER LogiSense <noreply@nerlogisense.gov.in>

# =========================
# AI & MACHINE LEARNING
# =========================
OPENAI_API_KEY=your_openai_api_key_here
ML_PREDICTION_ENABLED=false
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=5000

# =========================
# FIREBASE
# =========================
FIREBASE_PROJECT_ID=ner-logisense
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ner-logisense.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----"

# =========================
# STORAGE
# =========================
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET=ner-logisense-assets

# =========================
# MONITORING
# =========================
SENTRY_DSN=your_sentry_dsn_here

# =========================
# OPERATIONAL RISK THRESHOLDS
# =========================
RISK_CRITICAL_THRESHOLD=0.80
RISK_HIGH_THRESHOLD=0.60
RISK_MEDIUM_THRESHOLD=0.30
