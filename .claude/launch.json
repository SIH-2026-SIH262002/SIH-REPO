{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web-dashboard", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    },
    {
      "name": "auth-service",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend/auth-service", "run", "dev"],
      "port": 3000
    }
  ]
}
