# ==============================================================================
# Mobile Application Environment Configuration (Expo / React Native)
# Copy this file to apps/mobile-app/.env before running Expo app
# ==============================================================================

# Local Development URL (10.0.2.2 for Android Emulator, local IP for physical devices)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_APP_ENV=development

# GIS Map Provider & Key
EXPO_PUBLIC_MAP_PROVIDER=mapbox
EXPO_PUBLIC_MAP_API_KEY=your_mapbox_api_key_here

# Mappls (MapmyIndia) native map — set to "true" only after completing the
# Mappls Console setup below (android/app/README-MAPPLS.md). It stays off
# by default because the native SDK aborts at startup without a valid
# license file, and would otherwise break local builds.
EXPO_PUBLIC_USE_MAPPLS=false

# Production Backend URL (Uncomment when deployed)
# EXPO_PUBLIC_API_URL=https://api.nerlogisense.gov.in
