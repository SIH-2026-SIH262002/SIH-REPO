# ==============================================================================
# NER LogiSense - MOBILE FRONTEND ENVIRONMENT CONFIGURATION
# Location: apps/mobile-app/.env
# Serves: React Native + Expo Router Mobile Application
# ==============================================================================

# Backend API Endpoint (http://10.0.2.2:8000 for Android Emulator, or computer local IP)
# Using this machine's WiFi IP (found via `ipconfig`) so a real phone on the
# same WiFi can reach the backend. Re-check this IP if it changes networks --
# 10.0.2.2 only works for the Android Studio emulator, never a physical device.
EXPO_PUBLIC_API_URL=http://172.20.200.28:8000
EXPO_PUBLIC_APP_ENV=development

# GIS Map Provider & API Key
EXPO_PUBLIC_MAP_PROVIDER=mapbox
EXPO_PUBLIC_MAP_API_KEY=
