{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./app/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "env.d.ts"]
}
