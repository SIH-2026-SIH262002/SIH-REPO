# ==============================================================================
# NER LogiSense - FRONTEND DEDICATED ENVIRONMENT CONFIGURATION
# Location: apps/web-dashboard/.env
# Serves: React 19 + Vite Command Dashboard
# ==============================================================================

# Application & API Endpoints
# VITE_API_URL   -> FastAPI gateway (backend/app): operational/simulation data
# VITE_AUTH_URL  -> Express auth-service (backend/auth-service): identity & sessions
# VITE_CORE_URL  -> Java Spring Boot core-service (backend/core-service): PostGIS GIS core
VITE_APP_ENV=development
VITE_API_URL=http://localhost:8000/api
VITE_AUTH_URL=http://localhost:3000
VITE_CORE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8000/ws

# Closed System Security & Access Controls
VITE_ALLOW_PUBLIC_REGISTRATION=false

# GIS Map & Routing Client Config
# Mappls (MapmyIndia) is 100% Survey of India compliant.
VITE_MAP_PROVIDER=mappls
VITE_MAPPLS_API_KEY=13c08b6e6270d3d28754bb1db21eecf9
