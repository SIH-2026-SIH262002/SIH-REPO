# ==============================================================================
# NER LogiSense - FRONTEND DEDICATED ENVIRONMENT CONFIGURATION
# Location: apps/web-dashboard/.env
# Serves: React 19 + Vite Command Dashboard
# ==============================================================================

# Application & API Endpoints
# VITE_API_URL   -> FastAPI gateway (backend/app): operational/simulation data
#                   (sensors, routes, SOS, reports, vehicles, warehouses, notify, risk).
#                   MUST include the /api suffix -- every FastAPI router in this
#                   project is mounted under /api/*, and services/apiService.ts
#                   calls relative paths like "/dashboard/summary" that assume it.
# VITE_AUTH_URL  -> Express auth-service (backend/auth-service): identity,
#                   sessions, and the Admin Console's user directory/lifecycle.
#                   Mounted at bare /auth/* -- no /api suffix here.
# These are two separate services on two separate ports -- do not collapse
# them into one variable (see docs/ADMIN_CONSOLE_IMPLEMENTATION_SPEC.md §E.2).
VITE_APP_ENV=development
VITE_API_URL=http://127.0.0.1:8000/api
VITE_AUTH_URL=http://127.0.0.1:3000
VITE_WS_URL=ws://127.0.0.1:8000/ws

# GIS Map & Routing Client Config
VITE_MAP_PROVIDER=mapbox
VITE_MAP_API_KEY=

# Monitoring & Error Tracking
VITE_SENTRY_DSN=
