# ==============================================================================
# Web Command Dashboard Environment Configuration Template (Vite)
# Copy this file to apps/web-dashboard/.env before starting dev server
# ==============================================================================

VITE_APP_ENV=development
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# Closed System Enforcement
VITE_ALLOW_PUBLIC_REGISTRATION=false

# GIS Map & Routing
VITE_MAP_PROVIDER=mapbox
VITE_MAP_API_KEY=your_mapbox_api_key_here

# Monitoring
VITE_SENTRY_DSN=your_sentry_dsn_here
