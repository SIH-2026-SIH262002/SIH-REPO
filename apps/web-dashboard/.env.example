# ==============================================================================
# Web Command Dashboard Environment Configuration Template (Vite)
# Copy this file to apps/web-dashboard/.env before starting dev server
# ==============================================================================

VITE_APP_ENV=development
VITE_API_URL=http://localhost:8000/api
VITE_AUTH_URL=http://localhost:3000
VITE_CORE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8000/ws

# Closed System Enforcement
VITE_ALLOW_PUBLIC_REGISTRATION=false

# GIS Map & Routing Client Config (Mappls / MapmyIndia)
VITE_MAP_PROVIDER=mappls
VITE_MAPPLS_API_KEY=your_mappls_static_key_here
VITE_MAPBOX_API_KEY=your_mapbox_api_key_here
VITE_MAP_API_KEY=your_generic_map_api_key_here

# Weather & Environmental Intelligence APIs
VITE_OPENWEATHERMAP_API_KEY=your_openweather_api_key_here

# Notifications & Telecommunications (Twilio)
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token
VITE_TWILIO_SMS_FROM_NUMBER=+12015550123
VITE_TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:+14155238886

# Monitoring & Diagnostics
VITE_SENTRY_DSN=your_sentry_dsn_here

