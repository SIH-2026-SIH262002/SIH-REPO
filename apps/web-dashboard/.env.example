# ==============================================================================
# Web Command Dashboard Environment Configuration Template (Vite)
# Copy this file to apps/web-dashboard/.env before starting dev server
# ==============================================================================

VITE_APP_ENV=development
# FastAPI gateway (backend/app) -- operational/simulation data. Must include
# the /api suffix -- every FastAPI router here is mounted under /api/*.
VITE_API_URL=http://localhost:8000/api
# Express auth-service (backend/auth-service) -- identity, sessions, Admin
# Console user directory/lifecycle. Two separate services, two variables.
VITE_AUTH_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:8000/ws

# Closed System Enforcement
VITE_ALLOW_PUBLIC_REGISTRATION=false

# GIS Map & Routing
VITE_MAP_PROVIDER=mapbox
VITE_MAP_API_KEY=your_mapbox_api_key_here

# Monitoring
VITE_SENTRY_DSN=your_sentry_dsn_here
