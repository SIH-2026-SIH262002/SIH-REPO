# ==============================================================================
# NER LogiSense - BACKEND DEDICATED ENVIRONMENT CONFIGURATION TEMPLATE
# Location: backend/.env
# Serves: Python FastAPI Gateway, Enterprise Java Core, and Auth Service
# ==============================================================================

# =========================
# APPLICATION
# =========================
APP_ENV=development
APP_BASE_URL=http://localhost:8000
SERVER_PORT=8080

# =========================
# AUTH & SECURITY
# =========================
# SECURITY: Never commit real production secrets to source control.
# In production (APP_ENV=production / NODE_ENV=production), services will fail fast if JWT_SECRET is unset.
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars-long
JWT_ISSUER=ner-logisense-auth
JWT_AUDIENCE=ner-logisense-clients
JWT_EXPIRATION_MS=86400000
# Closed System Enforcement: Public self-registration is strictly disabled.
ALLOW_PUBLIC_REGISTRATION=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# =========================
# DATABASE (PostgreSQL / PostGIS & SQLite)
# =========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ner_logistics
POSTGRES_USER=sih_admin
POSTGRES_PASSWORD=sih_secure_password_2026

# Database aliases
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ner_logistics
DB_USER=sih_admin
DB_PASSWORD=sih_secure_password_2026
DATABASE_URL=sqlite:///./logisense.db

# =========================
# REDIS
# =========================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================
# KAFKA
# =========================
KAFKA_BROKERS=localhost:9092
KAFKA_SERVERS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=

# =========================
# MQTT / IoT
# =========================
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# =========================
# MAP / GIS
# =========================
MAP_PROVIDER=mapbox
MAP_API_KEY=

# =========================
# WEATHER
# =========================
WEATHER_API_KEY=
OPENWEATHERMAP_API_KEY=

# =========================
# ROUTING
# =========================
ROUTING_PROVIDER=ors
ROUTING_API_KEY=

# =========================
# NOTIFICATIONS (Twilio)
# =========================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:+14155238886

# =========================
# EMAIL
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=NER LogiSense <noreply@nerlogisense.gov.in>

# =========================
# AI & MACHINE LEARNING
# =========================
OPENAI_API_KEY=
ML_PREDICTION_ENABLED=false
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=5000

# =========================
# FIREBASE
# =========================
FIREBASE_PROJECT_ID=ner-logisense
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =========================
# STORAGE
# =========================
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=ner-logisense-assets

# =========================
# MONITORING
# =========================
SENTRY_DSN=

# =========================
# OPERATIONAL RISK THRESHOLDS
# =========================
RISK_CRITICAL_THRESHOLD=0.80
RISK_HIGH_THRESHOLD=0.60
RISK_MEDIUM_THRESHOLD=0.30
