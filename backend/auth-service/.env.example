# ==============================================================================
# NER LogiSense - Auth Service Environment Configuration Template
# Location: backend/auth-service/.env
# Serves: Express identity/session engine (login, provisioning, account
#         lifecycle) that the Admin Console and every other role log in
#         through.
# ==============================================================================

PORT=3000
CORS_ORIGIN=http://localhost:5173

# CRITICAL: this MUST be byte-for-byte identical to backend/.env's JWT_SECRET.
# This service issues the token every role (including Admin) authenticates
# with; the FastAPI gateway (backend/app) verifies that same token on every
# operational endpoint it protects. A mismatched secret makes every token
# fail signature verification cross-service -- every ADMIN-gated FastAPI
# route then 401s even for a correctly logged-in Administrator, with no
# error message pointing at the actual cause. See backend/.env.example.
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars-long

ACCESS_EXPIRY=15m
REFRESH_EXPIRY_MS=604800000
NODE_ENV=development
