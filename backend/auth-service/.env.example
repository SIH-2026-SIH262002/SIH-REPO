# AuthCore – environment variables
# Copy to .env in each subfolder (auth-engine and frontend) or set in your environment.
#
# --- auth-engine/.env ---
# PORT=3000
# CORS_ORIGIN=http://localhost:5173
# JWT_SECRET=your-super-secret-key-change-in-production
# ACCESS_EXPIRY=15m
# REFRESH_EXPIRY_MS=604800000
# NODE_ENV=development
#
# --- Neon Postgres ---
# Pooled connection (app runtime queries): run `neon connection-string <branch> --pooled`
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct/unpooled connection (drizzle-kit migrations only): run `neon connection-string <branch>`
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# --- frontend/.env ---
# VITE_API_URL=http://localhost:3000
